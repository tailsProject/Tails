# docker-compose.prod.yml 전용 시크릿 템플릿
# 사용법: cp .env.example .env

DB_PASSWORD=changeme

# RDS 엔드포인트로 교체
SPRING_DATASOURCE_URL=jdbc:mysql://YOUR_RDS_ENDPOINT:3306/tails?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul&useSSL=false&allowPublicKeyRetrieval=true

# 프론트 배포 origin (쿠키 기반 refreshToken을 쓰려면 명시적 origin 필요)
CORS_ALLOWED_ORIGINS=https://YOUR_DOMAIN

# openssl rand -base64 32 등으로 새로 발급
JWT_SECRET=changeme

# TourAPI/메일/FCM 선택값
TOUR_API_KEY=
MAIL_USERNAME=
MAIL_PASSWORD=
FIREBASE_CREDENTIALS_PATH=

# OAuth2는 더미 값 필수
KAKAO_CLIENT_ID=dummy
KAKAO_CLIENT_SECRET=dummy
GOOGLE_CLIENT_ID=dummy
GOOGLE_CLIENT_SECRET=dummy
NAVER_CLIENT_ID=dummy
NAVER_CLIENT_SECRET=dummy
