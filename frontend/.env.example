# 백엔드 API 서버 주소 (Spring Boot 기본 포트)
# 배포 환경(nginx가 프론트/백엔드 같은 origin으로 프록시)에서는 빈 값으로 둘 것
VITE_API_BASE_URL=http://localhost:8080

# 카카오맵 SDK - 카카오 개발자 콘솔에서 발급받은 JavaScript 키
VITE_KAKAO_MAP_KEY=

# Firebase 웹 앱 설정 (콘솔 > 프로젝트 설정 > 일반 > 내 앱) - 비워두면 FCM 웹 푸시 자동
# 비활성화(백엔드 firebase.credentials-path와 동일한 정책)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# FCM 웹 푸시 인증서 키 (콘솔 > 프로젝트 설정 > 클라우드 메시징)
VITE_FIREBASE_VAPID_KEY=
